# Copy to .env.local for local development and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://softforgeai.com

# Public contact details — leave empty to hide them on the site
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
# Optional booking link (Cal.com, Calendly, etc.)
NEXT_PUBLIC_CALENDAR_URL=

# Contact form delivery via Resend (https://resend.com) — server-only secrets
RESEND_API_KEY=
# Where inquiries are sent (comma-separate multiple addresses)
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "SoftForge AI <website@softforgeai.com>"
CONTACT_FROM_EMAIL=
